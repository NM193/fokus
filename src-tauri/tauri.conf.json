{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fokus",
  "version": "0.3.0",
  "identifier": "com.nemanja.fokus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1424",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fokus",
        "label": "main",
        "width": 1040,
        "height": 720,
        "minWidth": 880,
        "minHeight": 640,
        "resizable": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Light",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/NM193/fokus/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2QUU1OEJCRENGRURFRjYKUldUMjN2N2N1MWl1dHJNaXd2T2RUTzZRb3R0TFdYa1FERDZnN0NIT0hwcVo2Um16Y2k0bmp4KzQK"
    }
  }
}
